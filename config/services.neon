search:
	-
		in: %appDir%
		classes:
			- *Factory
			- *Facade


services:
	- App\Router\RouterFactory::createRouter
	- App\Localization\CatalogTranslator(%locale%, %debugMode%)
	- App\Model\UserAuthenticator
	- App\Services\UserService
	- App\Services\ConcertSongService
	- App\Services\SongFileStorage
	- App\Services\MailService
