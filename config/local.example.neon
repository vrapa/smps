includes:
	- parameters.neon
	- extensions.neon
	- doctrine.neon

# Debug mode is disabled by default. Set the SMPS_DEBUG environment variable to
# 1 only in a trusted local development environment when interactive debugging
# is required.

parameters:
    # Installation-wide UI language: cs, en, de, or nl. Keep cs until all
    # localization-plan UI stages are complete.
    locale: cs
    # Public name displayed in the navigation and browser title. This is not a
    # secret and lets another choir reuse the application without editing code.
    applicationName: SMPS Bruntál
    doctrine:
        host: 127.0.0.1
        user: root
        password:
        dbname: smps

application:
	errorPresenter: Error
	mapping:
		*: App\Modules\*\Presenters\*Presenter


session:
	expiration: 14 days
	autoStart: always
