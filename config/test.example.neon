# Copy to config/test.neon and set credentials for a dedicated disposable
# MySQL/MariaDB database. Never point this configuration at production.

includes:
	- parameters.neon
	- extensions.neon
	- doctrine.neon

parameters:
	doctrine:
		host: 127.0.0.1
		user: smps_test
		password: ''
		dbname: smps_test

application:
	errorPresenter: Error
	mapping:
		*: App\Modules\*\Presenters\*Presenter

session:
	expiration: 14 days
	autoStart: always
