# The production document root should point to www/. This file is a fail-safe for
# legacy hosting that exposes the project root instead.
Options -Indexes

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Existing project-root files and directories must never be served directly.
	RewriteCond %{REQUEST_URI} !^/www(?:/|$) [NC]
	RewriteCond %{REQUEST_URI} !^/?$
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [F,L]

	# Route all public requests through the real web root.
	RewriteCond %{REQUEST_URI} !^/www(?:/|$) [NC]
	RewriteRule ^(.*)$ www/$1 [L]
</IfModule>

# Fail closed when rewriting is unavailable; serving the project root is unsafe.
<IfModule !mod_rewrite.c>
	Require all denied
</IfModule>
