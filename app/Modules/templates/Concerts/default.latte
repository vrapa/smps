{* This is the welcome page, you can delete it *}

{block content}
    <div class="row">
        {include ../heading.latte}

        <table class="table table-striped table-bordered">
            <thead>
            <tr>
                <th scope="col">{_'concerts.list.column.title'}</th>
                <th scope="col" style="width: 180px;">{_'concerts.list.column.date'}</th>
                <th scope="col">{_'common.actions'}</th>
            </tr>
            </thead>
            <tbody>

            <tr n:if="count($concerts) === 0">
                <td colspan="3" class="text-center">{_'concerts.list.empty'}</td>
            </tr>
            {foreach $concerts as $concert}
                <tr>
                    {varType App\Model\entities\Concert $concert}
                    <td>
                        {$concert->getTitle()}
                    </td>
                    <td>
                        {$dateTimeFormatter->formatConcertDate($concert->getScheduledAt())}
                    </td>
                    <td>

                        {if $user->isInRole('admin')}
                            <div class="dropdown">
                                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    {_'common.options'}
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" n:href="show, 'id'=> $concert->getId()">{_'common.preview'}</a></li>
                                    <li><a class="dropdown-item" n:href="edit, 'id'=> $concert->getId()">{_'common.edit'}</a></li>
                                    <li>
                                        {var $deleteFormName = 'deleteForm-' . $concert->getId()}
                                        {form $deleteFormName, class: d-inline}
                                            {input send, class: 'dropdown-item'}
                                        {/form}
                                    </li>
                                </ul>
                            </div>
                        {else}
                            <a n:href="show, 'id'=> $concert->getId()" class="btn btn-info" role="button">{_'common.preview'}</a>
                        {/if}

                    </td>
                </tr>
                <tr>
                    <td colspan="3"  n:class="$concert->getNote() == null ? d-none">
                        {$concert->getNote()|breaklines}
                    </td>
                </tr>
            {/foreach}
            </tbody>
        </table>
    </div>

    {include ../Table/pagination.latte}

    {if $user->isInRole('admin')}
        <div class="panel panel-default">
            <div class="panel-body text-center">
                <a n:href="create" class="btn btn-info" role="button">{_'common.add_item'}</a>
            </div>
        </div>
    {/if}

{/block}

