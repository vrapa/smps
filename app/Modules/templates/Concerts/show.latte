{* This is the welcome page, you can delete it *}
{varType App\Model\entities\Concert $concert}
{block content}

    <div class="col-sm-12 text-left">
        {include ../heading.latte}
        <div class="container">
            <div class="row">
                <div class="col-md-12">

                    <nav class="navbar">
                        <ul class="nav navbar-nav">
                            <li><a n:href=":Concerts:default">{_'common.back_to_list'}</a></li>
                            {*<li><a href="#">Link</a></li>*}
                        </ul>
                    </nav>

                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">{$concert->getTitle()}</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-hover table-striped">
                                <tbody>
                                <tr>
                                    <td>
                                        <span class="label label-default">{_'concerts.detail.date'}</span>
                                    </td>
                                    <td>
                                         {$dateTimeFormatter->formatConcertDate($concert->getScheduledAt())}
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <span class="label label-default">{_'concerts.form.note'}</span>
                                    </td>
                                    <td>
                                        {$concert->getNote()|breaklines}
                                    </td>
                                </tr>
                                </tbody>
                            </table>

                            <h5>{_'concerts.form.songs'}</h5>
                            <p n:if="count($concertSongs) === 0" class="text-body-secondary">{_'concerts.program.empty'}</p>
                            <div n:if="count($concertSongs) > 0" class="list-group" n:inner-foreach="$concertSongs as $concertSong">
                                <a n:href=":Songs:show $concertSong->getSong()->getId()" class="list-group-item list-group-item-action">{$concertSong->getSong()->getTitle()}</a>
                            </div>


                        </div>
                    </div>

                </div>


            </div>
        </div>
    </div>

    </div>








{/block}

