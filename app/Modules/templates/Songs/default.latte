{* This is the welcome page, you can delete it *}

{block content}
    <div class="row">
        {include ../heading.latte}

        <table class="table table-striped table-bordered">
            <thead>
            <tr>
                <th scope="col">Název</th>
                <th scope="col">Autor</th>
                <th scope="col">Možnosti</th>

            </tr>
            </thead>
            <tbody>

            <tr n:foreach="$songs as $song" >
                <td>
                    {$song->getTitle()}
                </td>
                <td>
                    {$song->getAuthor()}
                </td>
                <td>
                    {if $user->isInRole('admin')}
                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Volby
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" n:href="show, 'id'=> $song->getId()">Náhled</a></li>
                                <li><a class="dropdown-item" n:href="edit, 'id'=> $song->getId()">Úpravy</a></li>
                                <li>
                                    {var $deleteFormName = 'deleteForm-' . $song->getId()}
                                    {form $deleteFormName, class: d-inline}
                                        {input send, class: 'dropdown-item'}
                                    {/form}
                                </li>
                            </ul>
                        </div>
                    {else}
                        <a n:href="show, 'id'=> $song->getId()" class="btn btn-info" role="button">Náhled</a>
                    {/if}
                </td>
            </tr>

            </tbody>
        </table>

    </div>

    {include ../Table/pagination.latte}

    {if $user->isInRole('admin')}
        <div class="panel panel-default">
            <div class="panel-body text-center">
                <a n:href="create" class="btn btn-info" role="button">Přidej položku</a>
            </div>
        </div>
    {/if}

{/block}
